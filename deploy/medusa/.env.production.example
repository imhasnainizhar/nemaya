# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — Medusa server + worker (deploy/medusa/docker-compose.yml)
# Copy to .env.production on the server. Never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
BACKEND_IMAGE=ghcr.io/your-github-user/nemaya-backend:latest
API_DOMAIN=api.nemaya.store
# set to 0.0.0.0 if you don't use the bundled Caddy proxy
API_BIND=127.0.0.1

# Neon Postgres (use the pooled connection string) ------------------------------
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Redis on its own instance (deploy/redis) --------------------------------------
REDIS_URL=redis://default:REDIS_PASSWORD@REDIS_PRIVATE_IP:6379

# Secrets — generate with: openssl rand -hex 32 ---------------------------------
JWT_SECRET=
COOKIE_SECRET=

# URLs & CORS -------------------------------------------------------------------
MEDUSA_BACKEND_URL=https://api.nemaya.store
STOREFRONT_URL=https://nemaya.store
STORE_CORS=https://nemaya.store,https://www.nemaya.store
ADMIN_CORS=https://api.nemaya.store
AUTH_CORS=https://nemaya.store,https://www.nemaya.store,https://api.nemaya.store

# First-run bootstrap (`docker compose run --rm migrate`) -------------------------
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_ALERT_EMAILS=you@example.com
SEED_DEMO_DATA=true

# Cloudflare R2 -----------------------------------------------------------------
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nemaya-media
S3_REGION=auto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# public URL of the bucket (custom domain or r2.dev URL), no trailing slash
S3_FILE_URL=https://media.nemaya.store

# Email (any SMTP: AWS SES, Resend, Postmark…) -----------------------------------
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nemaya <hello@nemaya.store>

# Web push (run `pnpm vapid` locally to generate) --------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@nemaya.store

# Stripe — TEST keys only (the backend refuses to boot with a live key) ----------
STRIPE_API_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
