# ─────────────────────────────────────────────────────────────────────────────
# STOREFRONT env — set these in the Vercel dashboard for production.
# (Local docker reads the root .env.docker instead.)
# ─────────────────────────────────────────────────────────────────────────────
# server-side only
MEDUSA_BACKEND_URL=https://api.nemaya.store
REVALIDATE_SECRET=

# public (inlined at build time)
NEXT_PUBLIC_BASE_URL=https://nemaya.store
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_
NEXT_PUBLIC_STRIPE_KEY=pk_test_
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# hostname of the R2 public bucket / custom domain, for next/image
NEXT_PUBLIC_MEDIA_HOST=media.nemaya.store
