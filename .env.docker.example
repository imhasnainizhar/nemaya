# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DOCKER ENVIRONMENT  (docker-compose.yml)
# Copied to .env.docker automatically by `pnpm docker:dev`, which also fills in
# fresh secrets + VAPID keys. Never use these values in production.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Postgres (container) ---------------------------------------------------------
POSTGRES_USER=nemaya
POSTGRES_PASSWORD=nemaya
POSTGRES_DB=nemaya
DATABASE_URL=postgres://nemaya:nemaya@postgres:5432/nemaya
DATABASE_SSL=false

# Redis (container) ------------------------------------------------------------
REDIS_URL=redis://redis:6379

# Medusa -----------------------------------------------------------------------
JWT_SECRET=__GENERATE__
COOKIE_SECRET=__GENERATE__
MEDUSA_WORKER_MODE=shared
# bind mounts on Windows/macOS are slow to load modules — give migrations time
MEDUSA_DB_MIGRATION_CONNECTION_TIMEOUT=180000
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
PUBLISHABLE_KEY_FILE=/shared/publishable-key
SEED_DEMO_DATA=true

# Admin user created on first boot → http://localhost:9000/app
ADMIN_EMAIL=admin@nemaya.local
ADMIN_PASSWORD=nemaya-admin-2026
ADMIN_ALERT_EMAILS=admin@nemaya.local

# File storage → RustFS S3 (stands in for Cloudflare R2) ---------------------------
S3_ACCESS_KEY_ID=nemaya
S3_SECRET_ACCESS_KEY=nemaya-secret
S3_BUCKET=nemaya-media
S3_REGION=us-east-1
S3_ENDPOINT=http://s3:9000
S3_FILE_URL=http://localhost:9100/nemaya-media

# Email → Mailpit (http://localhost:8025) --------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Nemaya <hello@nemaya.local>

# Web push (VAPID) — generated automatically ------------------------------------
VAPID_PUBLIC_KEY=__GENERATE__
VAPID_PRIVATE_KEY=__GENERATE__
VAPID_SUBJECT=mailto:hello@nemaya.local

# Stripe — TEST MODE ONLY (sk_test_… / pk_test_…). Leave empty to use the
# built-in test payment provider locally.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Storefront (Next.js) ---------------------------------------------------------
# MEDUSA_BACKEND_URL for the storefront is overridden to http://backend:9000 in compose.
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=__COPY_VAPID_PUBLIC__
REVALIDATE_SECRET=__GENERATE__
# Windows/macOS bind mounts don't forward file events → poll for changes
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
